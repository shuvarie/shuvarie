%YAML 1.2
---
# Rhai, for the codemode block's script listing.
#
# syntect ships the curated Sublime package list and Rhai is not in it, so this
# is the syntax set's one addition. It aims at *reading a script*, not at being
# a complete grammar: comments, every string form, char literals, numbers,
# keywords, and called names. Everything else stays the default text color, so a
# script full of `file.len` does not read as a wall of function names.
#
# The forms covered here are the ones Rhai 1.26.1's tokenizer accepts (checked
# against `rhai/src/tokenizer.rs` and the language cheat sheet). A rule that is
# merely *approximate* is worse than no rule: a string form that never closes
# paints the rest of the file as string text.
name: Rhai
file_extensions:
  - rhai
scope: source.rhai

contexts:
  main:
    - include: comments
    - include: strings

    # Keywords before operators, so `in`, `is`, and `as` are words; numbers and
    # strings before identifiers, so a literal is never read as a name.
    - match: '\b(let|const|if|else|for|in|while|loop|do|until|break|continue|fn|return|switch|try|catch|throw|import|export|as|is|private|global|this|exit|shared)\b'
      scope: keyword.control.rhai

    - match: '\b(true|false)\b'
      scope: constant.language.rhai

    # `switch`'s catch-all pattern.
    - match: '\b_\b'
      scope: constant.language.rhai

    # A name immediately before `(` is a call, which is the rule a reader uses.
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: entity.name.function.rhai

    # Radix literals first, so `0xFF` is not `0` followed by a name.
    - match: '\b0[xX][0-9a-fA-F_]+|\b0[bB][01_]+|\b0[oO][0-7_]+'
      scope: constant.numeric.rhai

    # A float needs a digit after the dot or an exponent, so `1..3` stays a
    # number and a range rather than a float and a stray dot.
    - match: '\b\d[\d_]*(?:\.\d[\d_]*(?:[eE][+-]?\d+)?|[eE][+-]?\d+)'
      scope: constant.numeric.rhai

    - match: '\b\d[\d_]*'
      scope: constant.numeric.rhai

    # Longest first: Oniguruma tries alternatives in order, so `..=` has to come
    # before `..` and `**=` before `**`.
    - match: '\.\.=|\*\*=|<<=|>>=|\?\?|\?\[|\?\.|\.\.|\*\*|<<|>>|<=|>=|==|!=|&&|\|\||=>|\+=|-=|\*=|/=|%=|&=|\|=|\^=|[+\-*/%<>=!&|^]'
      scope: keyword.operator.rhai

    - match: '[{}()\[\]]'
      scope: punctuation.section.rhai

    # `#{` is a map literal and `#[` a BLOB; both are one token. `::` is a
    # module path and has to precede the bare colon.
    - match: '#\{|#\[|::|[,;:.]'
      scope: punctuation.separator.rhai

  comments:
    # `///` and `/**` are Rhai's doc comments (`is_doc_comment` excludes the
    # four-character forms). `//!` is not one in Rhai, but it is the module-doc
    # convention and reads better painted than not.
    - match: '///(?!/).*$|//!.*$'
      scope: comment.line.documentation.rhai
    - match: '//.*$'
      scope: comment.line.double-slash.rhai
    # Block comments nest in Rhai, and the inner one closes first, so this
    # context pushes itself rather than popping at the first `*/`.
    - match: '/\*\*(?!/)'
      push: doc_block_comment
    - match: '/\*'
      scope: comment.block.rhai
      push: block_comment

  block_comment:
    - meta_scope: comment.block.rhai
    - match: '/\*'
      push: block_comment
    - match: '\*/'
      pop: true

  doc_block_comment:
    - meta_scope: comment.block.documentation.rhai
    # A comment nested inside a doc comment is an ordinary one.
    - match: '/\*'
      push: block_comment
    - match: '\*/'
      pop: true

  strings:
    # Rhai's literal strings: `#"…"#` takes no escapes and may hold quotes and
    # newlines, so it ends only at `"#`. Before the plain `"` rule, or the first
    # inner quote would end it.
    - match: '#"'
      scope: punctuation.definition.string.begin.rhai
      push: literal_string
    - match: '"'
      scope: punctuation.definition.string.begin.rhai
      push: double_string
    # Backtick strings interpolate with `${...}`.
    - match: '`'
      scope: punctuation.definition.string.begin.rhai
      push: backtick_string
    # A char literal is one scalar value: an escape, or any single character.
    # Handling it matters beyond coloring: `'"'` read as a string opener would
    # swallow the rest of the script.
    - match: "'(?:\\\\.|[^'\\\\])'"
      scope: string.quoted.single.rhai

  double_string:
    - meta_scope: string.quoted.double.rhai
    - match: '\\.'
      scope: string.escape.rhai
    - match: '"'
      scope: punctuation.definition.string.end.rhai
      pop: true

  literal_string:
    - meta_scope: string.quoted.other.rhai.literal
    - match: '"#'
      scope: punctuation.definition.string.end.rhai
      pop: true

  backtick_string:
    - meta_scope: string.quoted.other.rhai
    - match: '\\.'
      scope: string.escape.rhai
    # The interpolation itself is code, so paint it as such.
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.rhai
      push: interpolation
    - match: '`'
      scope: punctuation.definition.string.end.rhai
      pop: true

  interpolation:
    - clear_scopes: 1
    # This context's own `}` has to come *before* `include: main`: includes expand
    # inline, and main paints `}` as punctuation, so a `}` rule placed after the
    # include never matches. The interpolation would then stay open for the rest
    # of the file -- the string's tail reads as code, and its closing backtick is
    # taken for the start of a new string.
    - match: '\}'
      scope: punctuation.section.interpolation.end.rhai
      pop: true
    # A map literal (or any braced group) nests inside the interpolation, so its
    # `}` must not end it. Count braces rather than closing at the first one.
    - match: '#?\{'
      scope: punctuation.section.rhai
      push: interpolation_brace
    - include: main

  interpolation_brace:
    - match: '\}'
      scope: punctuation.section.rhai
      pop: true
    - match: '#?\{'
      scope: punctuation.section.rhai
      push: interpolation_brace
    - include: main
